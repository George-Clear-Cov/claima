generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  name                 String
  hashedPassword       String
  practiceId           String
  role                 UserRole  @default(BILLER)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime  @default(now())

  // Set once the address has been proven with an emailed code. Required before the
  // account may send us PHI — an unverified address is an unidentified counterparty,
  // and a backlog import is the largest PHI ingress in the product.
  emailVerifiedAt      DateTime?

  // TOTP multi-factor auth for email/password logins (SSO logins inherit MFA from the IdP).
  mfaEnabled           Boolean   @default(false)
  mfaSecret            String?   // base32 TOTP secret; stored at setup, enforced once mfaEnabled
  mfaBackupCodes       String[]  @default([]) // bcrypt hashes of unused single-use backup codes

  practice Practice @relation(fields: [practiceId], references: [id])
}

enum UserRole {
  ADMIN
  BILLER
}

model Practice {
  id                String   @id @default(uuid())
  name              String
  npi               String   @unique
  taxId             String
  taxonomy          String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  zip               String
  phone             String
  stripeAccountId   String?
  stripeOnboarded   Boolean  @default(false)
  platformFeePercent Float   @default(5.0)
  baaAcceptedAt     DateTime?
  baaAcceptedIp     String?
  // The BAA is a data-protection agreement and creates no commercial relationship. The
  // services agreement is what establishes the engagement and the contingency fee, so it
  // is recorded independently and must never be inferred from baaAcceptedAt.
  servicesAgreementAcceptedAt DateTime?
  servicesAgreementAcceptedIp String?
  createdAt         DateTime @default(now())

  providers               Provider[]
  patients                Patient[]
  claims                  Claim[]
  users                   User[]
  marketplaceSubscriptions MarketplaceSubscription[]
  eras                    ERA[]
  payerEnrollments        PracticePayerEnrollment[]
  priorAuths              PriorAuthorization[]
  ccmTimeLogs             CcmTimeLog[]
  providerCredentials     ProviderCredential[]
  oigChecks               OigCheck[]
  aiUsage                 AiUsage[]
  feeSchedule             FeeScheduleEntry[]
  remittanceLines         RemittanceLine[]
  goodFaithEstimates      GoodFaithEstimate[]
}

model AiUsage {
  id            String   @id @default(uuid())
  practiceId    String
  day           String   // YYYY-MM-DD (UTC) — daily bucket
  calls         Int      @default(0)
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  estCostMicros Int      @default(0) // estimated cost in micro-USD (1e-6 USD)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  practice      Practice @relation(fields: [practiceId], references: [id])

  @@unique([practiceId, day])
  @@index([practiceId, day])
}

model Provider {
  id                   String    @id @default(uuid())
  practiceId           String
  firstName            String
  lastName             String
  npi                  String    @unique
  taxonomy             String
  deaNumber            String?
  deaExpiry            DateTime?
  stateLicense         String?
  stateLicenseState    String?
  stateLicenseExpiry   DateTime?
  boardCertExpiry      DateTime?
  malpracticeCarrier   String?
  malpracticeExpiry    DateTime?
  caqhProviderId       String?
  caqhLastUpdated      DateTime?
  createdAt            DateTime  @default(now())

  practice            Practice             @relation(fields: [practiceId], references: [id])
  claims              Claim[]
  payerCredentials    ProviderCredential[]
  oigChecks           OigCheck[]
}

model ProviderCredential {
  id              String           @id @default(uuid())
  practiceId      String
  providerId      String
  payerId         String
  payerName       String
  status          CredentialStatus @default(PENDING)
  applicationDate DateTime?
  approvedDate    DateTime?
  expiryDate      DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@unique([providerId, payerId])
  @@index([practiceId])
}

enum CredentialStatus {
  PENDING
  IN_REVIEW
  APPROVED
  DENIED
  EXPIRED
  RE_CREDENTIALING
}

model Patient {
  id                       String   @id @default(uuid())
  practiceId               String
  firstName                String
  lastName                 String
  dob                      DateTime
  gender                   String
  memberId                 String
  groupNumber              String?
  payerId                  String
  payerName                String
  relationshipToSubscriber String   @default("18")
  addressLine1             String
  city                     String
  state                    String
  zip                      String
  email                    String?
  phone                    String?
  ccmEnrolled              Boolean  @default(false)
  ccmEnrolledAt            DateTime?
  ccmConsentedAt           DateTime?
  createdAt                DateTime @default(now())

  practice          Practice           @relation(fields: [practiceId], references: [id])
  claims            Claim[]
  eligibilityChecks EligibilityCheck[]
  statements        PatientStatement[]
  priorAuths        PriorAuthorization[]
  ccmTimeLogs       CcmTimeLog[]
  goodFaithEstimates GoodFaithEstimate[]
}

model Claim {
  id                   String      @id @default(uuid())
  practiceId           String
  providerId           String
  patientId            String
  serviceDate          DateTime
  claimStatus          ClaimStatus @default(DRAFT)
  totalCharge          Decimal     @db.Decimal(10, 2)
  placeOfService       String      @default("11")
  referringProviderNpi String?
  priorAuthId          String?
  stediClaimId         String?
  stediResponse        Json?
  denialCode           String?
  denialReason         String?
  submittedAt          DateTime?
  paidAmount           Decimal?    @db.Decimal(10, 2)
  paidAt               DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  practice   Practice               @relation(fields: [practiceId], references: [id])
  provider   Provider               @relation(fields: [providerId], references: [id])
  patient    Patient                @relation(fields: [patientId], references: [id])
  priorAuth  PriorAuthorization?    @relation(fields: [priorAuthId], references: [id])
  lineItems  ClaimLine[]
  denial     Denial?
  statement  PatientStatement?
  era        ERA?
  eligibilityChecks EligibilityCheck[]
  remittanceLines   RemittanceLine[]
}

model Denial {
  id             String       @id @default(uuid())
  claimId        String       @unique
  carcCode       String
  denialReason   String
  category       String
  priority       String
  action         String
  appealable     Boolean
  appealStatus   AppealStatus @default(PENDING)
  appealLetter   String?
  appealedAt     DateTime?
  resolvedAt     DateTime?
  resolution     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  claim Claim @relation(fields: [claimId], references: [id])
}

model PatientStatement {
  id               String          @id @default(uuid())
  patientId        String
  claimId          String          @unique
  totalCharge      Decimal         @db.Decimal(10, 2)
  insurancePaid    Decimal         @db.Decimal(10, 2)
  adjustments      Decimal         @db.Decimal(10, 2) @default(0)
  // Patient-responsibility split (from 835 CAS PR group) — powers the transparency EOB
  deductible       Decimal         @db.Decimal(10, 2) @default(0)
  coinsurance      Decimal         @db.Decimal(10, 2) @default(0)
  copay            Decimal         @db.Decimal(10, 2) @default(0)
  patientOwes      Decimal         @db.Decimal(10, 2)
  patientPaid      Decimal         @db.Decimal(10, 2) @default(0)
  balanceDue       Decimal         @db.Decimal(10, 2)
  statementStatus  StatementStatus @default(PENDING)
  dueDate          DateTime?
  paidAt           DateTime?
  outreachSentAt   DateTime?
  outreachCount    Int             @default(0)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  claim   Claim   @relation(fields: [claimId], references: [id])
}

enum StatementStatus {
  PENDING
  SENT
  PARTIAL
  PAID
  WRITE_OFF
  COLLECTIONS
}

enum AppealStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  WON
  LOST
  WRITE_OFF
}

model EligibilityCheck {
  id               String   @id @default(uuid())
  patientId        String
  payerId          String
  memberId         String
  eligible         Boolean
  coverageActive   Boolean
  planName         String?
  groupNumber      String?
  deductible       Decimal? @db.Decimal(10, 2)
  deductibleMet    Decimal? @db.Decimal(10, 2)
  outOfPocketMax   Decimal? @db.Decimal(10, 2)
  outOfPocketMet   Decimal? @db.Decimal(10, 2)
  deductibleRemaining  Decimal? @db.Decimal(10, 2)
  outOfPocketRemaining Decimal? @db.Decimal(10, 2)
  copay            Decimal? @db.Decimal(10, 2)
  coinsurance      Int?
  visitLimit       Int?
  visitsUsed       Int?
  priorAuthRequired Boolean @default(false)
  inNetwork        Boolean  @default(true)
  effectiveDate    String?
  terminationDate  String?
  rawResponse      Json?
  claimId          String?
  checkedAt        DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  claim   Claim?  @relation(fields: [claimId], references: [id])

  @@index([patientId])
  @@index([claimId])
}

model ClaimLine {
  id           String   @id @default(uuid())
  claimId      String
  cptCode      String
  icd10Codes   String[]
  modifier     String?
  units        Int      @default(1)
  chargeAmount Decimal  @db.Decimal(10, 2)
  description  String?

  claim Claim @relation(fields: [claimId], references: [id])
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  DENIED
  PAID
}

model AuditLog {
  id         String   @id @default(uuid())
  practiceId String?
  userId     String?
  userEmail  String?
  action     String
  resource   String?
  resourceId String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([practiceId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

/**
 * Short-lived email verification codes. The code itself is never stored — only a SHA-256
 * hash — so a database read cannot be replayed to verify someone else's address. Attempts
 * are counted so a 6-digit code cannot be brute forced.
 */
model EmailVerificationCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model ERA {
  id                    String    @id @default(cuid())
  practiceId            String
  claimId               String?   @unique
  claimMdEraId          String
  checkNumber           String?
  payerId               String
  payerName             String
  claimMdClaimId        String?
  patientFirstName      String?
  patientLastName       String?
  serviceDate           DateTime?
  chargeAmount          Decimal?  @db.Decimal(10, 2)
  insurancePaid         Decimal   @db.Decimal(10, 2)
  adjustments           Decimal   @db.Decimal(10, 2)
  patientResponsibility Decimal   @db.Decimal(10, 2)
  deductible            Decimal   @db.Decimal(10, 2) @default(0)
  coinsurance           Decimal   @db.Decimal(10, 2) @default(0)
  copay                 Decimal   @db.Decimal(10, 2) @default(0)
  otherPatientResp      Decimal   @db.Decimal(10, 2) @default(0)
  carcCodes             String[]
  rawData               Json
  matchedAt             DateTime?
  processedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  practice        Practice         @relation(fields: [practiceId], references: [id])
  claim           Claim?           @relation(fields: [claimId], references: [id])
  remittanceLines RemittanceLine[]

  @@index([practiceId, createdAt])
}

model PracticePayerEnrollment {
  id               String           @id @default(cuid())
  practiceId       String
  payerId          String
  payerName        String
  enrollmentStatus EnrollmentStatus @default(PENDING)
  claimMdPayerId   String?
  enrolledAt       DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id])

  @@unique([practiceId, payerId])
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model MarketplaceSubscription {
  id             String    @id @default(uuid())
  practiceId     String?
  marketplace    String
  externalId     String    @unique
  productCode    String?
  planId         String?
  status         String
  quantity       Int       @default(1)
  activatedAt    DateTime?
  cancelledAt    DateTime?
  rawPayload     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  practice Practice? @relation(fields: [practiceId], references: [id])

  @@index([marketplace, externalId])
}

enum PAStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CANCELLED
}

model PriorAuthorization {
  id               String    @id @default(uuid())
  practiceId       String
  patientId        String
  payerId          String
  payerName        String
  cptCodes         String[]
  authNumber       String?
  status           PAStatus  @default(PENDING)
  requestedAt      DateTime  @default(now())
  approvedAt       DateTime?
  expiresAt        DateTime?
  sessionsApproved Int?
  sessionsUsed     Int       @default(0)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])
  claims   Claim[]

  @@index([practiceId])
  @@index([patientId])
}

enum OigStatus {
  CLEAR
  EXCLUDED
  ERROR
}

model OigCheck {
  id           String    @id @default(uuid())
  practiceId   String
  providerId   String
  checkedAt    DateTime  @default(now())
  status       OigStatus @default(CLEAR)
  matchFound   Boolean   @default(false)
  matchDetails Json?
  error        String?

  practice Practice @relation(fields: [practiceId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([practiceId])
  @@index([providerId, checkedAt])
}

model CcmTimeLog {
  id          String   @id @default(uuid())
  practiceId  String
  patientId   String
  logDate     DateTime @default(now())
  minutes     Int
  description String?
  createdAt   DateTime @default(now())

  practice Practice @relation(fields: [practiceId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])

  @@index([practiceId])
  @@index([patientId, logDate])
}

// ── Patient cost transparency ──────────────────────────────────────────────
// Per-service-line remittance detail. The 835 parser computes this per line; we
// persist it so a patient can see, for each CPT: billed → allowed → insurance
// paid → their responsibility, split into deductible / coinsurance / copay.
model RemittanceLine {
  id                    String    @id @default(uuid())
  practiceId            String
  eraId                 String
  claimId               String?
  cptCode               String
  modifiers             String[]  @default([])
  units                 Int       @default(1)
  serviceDate           DateTime?
  chargeAmount          Decimal   @db.Decimal(10, 2)
  allowedAmount         Decimal?  @db.Decimal(10, 2)
  insurancePaid         Decimal   @db.Decimal(10, 2) @default(0)
  contractualAdjustment Decimal   @db.Decimal(10, 2) @default(0) // CAS group CO (plan write-off)
  patientResponsibility Decimal   @db.Decimal(10, 2) @default(0) // total PR
  deductible            Decimal   @db.Decimal(10, 2) @default(0) // PR-1
  coinsurance           Decimal   @db.Decimal(10, 2) @default(0) // PR-2
  copay                 Decimal   @db.Decimal(10, 2) @default(0) // PR-3
  otherPatientResp      Decimal   @db.Decimal(10, 2) @default(0) // other PR (non-covered, etc.)
  carcCodes             String[]  @default([])
  createdAt             DateTime  @default(now())

  practice Practice @relation(fields: [practiceId], references: [id])
  era      ERA      @relation(fields: [eraId], references: [id], onDelete: Cascade)
  claim    Claim?   @relation(fields: [claimId], references: [id])

  @@index([practiceId])
  @@index([eraId])
  @@index([claimId])
}

// Charge master / fee schedule. Authoritative expected charges per CPT — the
// source a compliant Good Faith Estimate cites. payerId null = practice list
// price (self-pay / GFE); a payerId row carries the expected in-network allowed.
model FeeScheduleEntry {
  id              String    @id @default(uuid())
  practiceId      String
  cptCode         String
  modifier        String?
  payerId         String?   // null = practice default / self-pay list price
  payerName       String?
  expectedCharge  Decimal   @db.Decimal(10, 2)  // cited on the Good Faith Estimate
  expectedAllowed Decimal?  @db.Decimal(10, 2)  // expected payer allowed (insured estimate)
  source          FeeSource @default(MANUAL)
  effectiveDate   DateTime  @default(now())
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  practice Practice @relation(fields: [practiceId], references: [id])

  @@unique([practiceId, cptCode, modifier, payerId, effectiveDate])
  @@index([practiceId, cptCode])
}

enum FeeSource {
  MANUAL
  DERIVED
  IMPORTED
}

// A compliant Good Faith Estimate (No Surprises Act). Persisted as an immutable
// snapshot for the required retention period (≥6 years). `lines` holds the
// EstimateLine[] exactly as shown to the patient; `disclaimer` is the served text.
model GoodFaithEstimate {
  id              String    @id @default(uuid())
  practiceId      String
  patientId       String?
  providerId      String?
  payerId         String?
  payerName       String?
  insured         Boolean   @default(false)
  totalCharge     Decimal   @db.Decimal(10, 2)
  totalAllowed    Decimal   @db.Decimal(10, 2)
  patientEstimate Decimal   @db.Decimal(10, 2)
  lines           Json      // EstimateLine[] snapshot as presented
  diagnosisCodes  String[]  @default([])
  disclaimer      String
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  practice Practice @relation(fields: [practiceId], references: [id])
  patient  Patient? @relation(fields: [patientId], references: [id])

  @@index([practiceId, createdAt])
  @@index([patientId])
}
